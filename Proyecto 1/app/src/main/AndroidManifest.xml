<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_bg_removed_foreground"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_bg_removed_foreground"
        android:supportsRtl="true"
        android:theme="@style/Theme.Proyecto1">

        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="true" />

        <service
            android:name=".data.remote.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <activity
            android:name=".presentation.view.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".presentation.view.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".presentation.view.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".presentation.view.UsersActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".presentation.view.ImageViewerActivity"
            android:exported="false"/>

        <activity
            android:name=".presentation.view.ProfileActivity"
            android:exported="false"/>

        <activity
            android:name=".presentation.view.CropPhotoActivity"
            android:exported="false" />
    </application>

</manifest>